# Copy to supabase/.env.test; if using argonplat-local-network, pass --network-id argonplat-local-network to supabase functions serve.
# Keep real credentials local; never paste them into chat or commit them to Git.
ARGON_ENVIRONMENT=test
B2_BUCKET=argonplat-test-bucket
ARGON_TEST_B2_BUCKET=argonplat-test-bucket
B2_REGION=eu-central-003
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_APPLICATION_KEY_ID=replace-with-test-bucket-key-id
B2_APPLICATION_KEY=replace-with-test-bucket-application-key
